# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Set this to true only after Google is enabled in Supabase Authentication and
# its authorized redirect URL is configured. Defaults to hidden for customers.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Server-only integrations (configure in Vercel/Supabase, never expose to the browser)
# Preferred modern server key. The Vercel Supabase integration can supply the
# legacy service-role JWT below when this modern key is unavailable.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=yamzouttara.com,www.yamzouttara.com
YAMZO_RATE_LIMIT_SECRET=

# Customer email campaigns: server-only Resend credentials. Campaigns are
# consent-first and require a verified sender plus a dedicated Resend segment.
RESEND_API_KEY=
RESEND_CUSTOMERS_SEGMENT_ID=
RESEND_CUSTOMERS_FROM=
RESEND_CUSTOMERS_REPLY_TO=

# Optional observability and Meta integration. CAPI secrets belong in Supabase Vault.
NEXT_PUBLIC_SITE_URL=https://yamzouttara.com
